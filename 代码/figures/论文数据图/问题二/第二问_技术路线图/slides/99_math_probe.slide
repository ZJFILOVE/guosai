<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', padding: 0 }}>
    {/* 4 x 3 网格，每格 300x210，用于测量公式实际渲染尺寸 */}
    <Box style={{ position: 'absolute', left: 20, top: 20, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex='\rho_q(u)=\begin{cases}qu, & u\ge 0\\ (q-1)u, & u<0\end{cases}' width={230} display={true} color='#0E3F8C' /></Box>
    <Box style={{ position: 'absolute', left: 330, top: 20, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex='\min_{f}\sum_{j\in\mathcal{T}_d}\omega_j\sum_t\rho_q\bigl(x_{j,t}-f(\mathbf{x}_{j,t})\bigr)' width={280} display={true} color='#0E3F8C' /></Box>
    <Box style={{ position: 'absolute', left: 640, top: 20, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex='\widehat{X}_{d,t}^{(q)}=B_{d,t}^{(q)}+a_{d,\ell}^{(q)}' width={240} display={true} color='#0E3F8C' /></Box>
    <Box style={{ position: 'absolute', left: 950, top: 20, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex='\min_{g,\bar b,\bar c,\bar w}\ \sum_{t=1}^{144} p_t\,g_{d,t}' width={240} display={true} color='#0E3F8C' /></Box>

    <Box style={{ position: 'absolute', left: 20, top: 250, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex='\bar E_{d,t}=\bar E_{d,t-1}+0.9\bar c_{d,t}-\bar b_{d,t}/0.9' width={260} display={true} color='#0E3F8C' /></Box>
    <Box style={{ position: 'absolute', left: 330, top: 250, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex='z_{j,t}=\bigl(X_{j,t}-\widehat X_{j,t}^{(0.5)}\bigr)/\sigma_{j,t}' width={250} display={true} color='#0E3F8C' /></Box>
    <Box style={{ position: 'absolute', left: 640, top: 250, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex='P_{t,ij}=\frac{C_{t,ij}+3P^{\mathrm{all}}_{ij}}{\sum_h\bigl(C_{t,ih}+3P^{\mathrm{all}}_{ih}\bigr)}' width={270} display={true} color='#0E3F8C' /></Box>
    <Box style={{ position: 'absolute', left: 950, top: 250, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex='W_t(x,i)=\sum_k w_{t,i,k}\,\mathcal{T}_{t,i}(x,n_{t,i,k})' width={250} display={true} color='#0E3F8C' /></Box>

    <Box style={{ position: 'absolute', left: 20, top: 480, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex="F_{t,i}(x')=\sum_j P_{t,ij}W_{t+1}(x',j)" width={240} display={true} color='#0E3F8C' /></Box>
    <Box style={{ position: 'absolute', left: 330, top: 480, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex='E_{d,t}=E_{d,t-1}+0.9c_{d,t}-\frac{b_{d,t}}{0.9}' width={250} display={true} color='#0E3F8C' /></Box>
    <Box style={{ position: 'absolute', left: 640, top: 480, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex='1200\le E_{d,t}\le 10800,\quad 0\le c,b\le 5000/6' width={270} display={true} color='#0E3F8C' /></Box>
    <Box style={{ position: 'absolute', left: 950, top: 480, width: 300, height: 210, background: '#EAF1F9', border: '1px solid #8FA8C0' }}><Math latex='C=\sum_d\sum_t\bigl(p_t g_{d,t}+5p_t e_{d,t}\bigr)' width={250} display={true} color='#0E3F8C' /></Box>
</Slide>
